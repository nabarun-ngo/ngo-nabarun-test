<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" packages="ngo.nabarun.test.ngo_nabarun_test.utils">
    <Properties>
        <!-- Reads LOG_LEVEL from Environment Variables, fallback to INFO if not set -->
        <Property name="logLevel">${env:LOG_LEVEL:-INFO}</Property>
    </Properties>

    <Appenders>
        <!-- Console Logging -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level - %msg%n" />
            <!-- Keep console restricted to WARN or higher for cleaner output -->
            <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>

        <!-- Overall Execution Log File -->
        <File name="ExecutionFile" fileName="target/execution.log" immediateFlush="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level - %msg%n" />
            <ThresholdFilter level="${logLevel}" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>

        <!-- Programmatic Memory Logging for Cucumber Reports -->
        <MemoryAppender name="MemoryAppender">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level - %msg%n" />
        </MemoryAppender>
    </Appenders>

    <Loggers>
        <Root level="${logLevel}">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ExecutionFile"/>
            <AppenderRef ref="MemoryAppender"/>
        </Root>
    </Loggers>
</Configuration>
