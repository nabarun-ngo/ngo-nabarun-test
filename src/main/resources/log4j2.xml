<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Reads LOG_LEVEL from Environment Variables, fallback to INFO if not set -->
        <Property name="logLevel">${env:LOG_LEVEL:-INFO}</Property>
    </Properties>

    <Appenders>
        <!-- Console Logging -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level - %msg%n" />
            <!-- Keep console restricted to WARN or higher for cleaner output -->
            <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>

        <!-- Dynamic File Logging per scenario -->
        <Routing name="RoutingAppender">
            <Routes pattern="$${ctx:scenarioName}">
                <!-- This route is chosen when scenarioName is set in ThreadContext -->
                <Route>
                    <File name="FileLogger-${ctx:scenarioName}" fileName="target/logs/${ctx:scenarioName}.log">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level - %msg%n" />
                        <ThresholdFilter level="${logLevel}" onMatch="ACCEPT" onMismatch="DENY"/>
                    </File>
                </Route>
                
                <!-- Default route when scenarioName is not set -->
                <Route key="$${ctx:scenarioName}">
                    <File name="DefaultFileLogger" fileName="target/logs/test.log">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level - %msg%n" />
                        <ThresholdFilter level="${logLevel}" onMatch="ACCEPT" onMismatch="DENY"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="${logLevel}">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RoutingAppender"/>
        </Root>
    </Loggers>
</Configuration>
